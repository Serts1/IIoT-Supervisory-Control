    {
        "id": "f860a0e5efe13a0a",
        "type": "function",
        "z": "ce6785f857b8e2b3",
        "g": "bc6e0bb813844787",
        "name": "G2",
        "func": "const initstate = \"q21\";\nconst e2_1 = msg.event.e21;\nconst e2_2 = msg.event.e22;\n\n//Initialize the state q21\nlet  state = context.get(\"state\");\nif (!state){\n    state = initstate;\n    context.set(\"state\",state);\n}\n\nlet update = false;\n\n//Transistions\nif (state === \"q21\" && e2_1 === true) {\n    state = \"q22\";\n    update = true;\n}\nelse if (state === \"q22\" && e2_2 === true) {\n    state = \"q21\";\n    update = true;\n}\n\n//Save new state\nif (update == true) {\n    context.set(\"state\", state);\n}\n\n//Output state\nmsg.currentstateG2 = state;\n\nreturn msg;",
        "outputs": 1,
