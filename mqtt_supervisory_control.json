    {
        "id": "ac4aa517131d95aa",
        "type": "function",
        "z": "ce6785f857b8e2b3",
        "g": "bc6e0bb813844787",
        "name": "S1",
        "func": "const initstate = \"qs11\";\nconst e1_1 = msg.event.e11;\nconst e2_1 = msg.event.e21;\nconst e2_2 = msg.event.e22;\n\n// Initialize the state qs1.1\nlet state = context.get(\"state\");\nif (!state){\n    state = initstate;\n    context.set(\"state\", state);\n}\n\nlet update = false;\n\n// Transistions \nif (state === \"qs11\" && e2_1 === true) {\n    state = \"qs12\";\n    update = true;\n}\nelse if (state === \"qs11\" && e2_2 === true) {\n    state = \"qs11\";\n    update = true;\n}\nelse if (state === \"qs12\" && e2_2 === true) {\n    state = \"qs11\";\n    update = true;\n}\nelse if (state === \"qs12\" && (e1_1 === true || e2_1 === true) ) {\n    state = \"qs12\";\n    update = true;\n}\n\n//Save new state\nif (update == true) {\n    context.set(\"state\", state);\n}\n\n//Output state\nmsg.currentstateS1 = state;\n\nreturn msg;",
