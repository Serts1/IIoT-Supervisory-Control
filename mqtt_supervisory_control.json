    {
        "id": "20f1e99ec391df97",
        "type": "function",
        "z": "ce6785f857b8e2b3",
        "g": "bc6e0bb813844787",
        "name": "G1",
        "func": "const initstate = \"q11\";\nconst e1_1 = msg.event.e11;\nconst e1_2 = msg.event.e12;\n\n// Initialize the state q1.1\nlet state = context.get(\"state\");\nif (!state) {\n    state = initstate;\n    context.set(\"state\",state);\n}\n\nlet update = false;\n\n// Transistions \nif (state === \"q11\" && e1_1 === true){\n    state = \"q12\";\n    update = true;\n}\nelse if (state === \"q12\" && e1_2 === true){\n    state = \"q11\";\n    update = true;\n}\n\n//Save new state\nif (update == true){\n    context.set(\"state\" , state);\n}\n\n//Output state\nmsg.currentstateG1 = state;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 990,
